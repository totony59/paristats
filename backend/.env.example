DATABASE_URL="file:./dev.db"
PORT=3001

# Laisser vide pour utiliser le mode mock (analyse simulée, aucun appel réseau).
# Renseigner une vraie clé pour activer l'analyse Claude Vision réelle.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optionnel. Force le mode d'analyse sans toucher à ANTHROPIC_API_KEY :
#   claude -> force l'appel réel (erreur claire si la clé est absente)
#   mock   -> force le mode simulé même si une clé est configurée (repli rapide en cas de souci)
# Laisser vide = comportement automatique (clé présente -> claude, sinon -> mock).
AI_PROVIDER=

# Taille max d'une capture importée, en Mo.
MAX_UPLOAD_MB=8
