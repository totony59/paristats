# URL du backend hébergé (Render). Modifiable aussi depuis l'app (écran Accueil)
# sans reconstruire. Pour du développement local sur le même Wi-Fi, utiliser
# l'IP locale du PC à la place (ex. http://192.168.1.100:3001, trouvable via
# `ipconfig` sur Windows).
EXPO_PUBLIC_API_URL=https://paristats-backend.onrender.com
